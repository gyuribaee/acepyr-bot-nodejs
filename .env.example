# Acepyr Prediction Market Bot — Konfigurasi

# Email akun Acepyr
EMAIL=fajrulirfan12345@gmail.com

# Password akun Acepyr
PASSWORD=

# Nama pasar (market) yang ingin ditaruhi
MARKET=QQQ

# Sisi taruhan: "Up" atau "Down"
SIDE=Down

# Jumlah taruhan (dalam satuan platform)
AMOUNT=0.25

# URL halaman utama Acepyr
URL=https://acepyr.com/home

# Mode kepala (true = tanpa tampilan, false = dengan tampilan)
HEADLESS=false

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Timeout (ms)
TIMEOUT=60000

# Jumlah percobaan
RETRY=3
